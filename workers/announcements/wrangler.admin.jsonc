{
  "name": "oc2modmanager-notice-admin",
  "main": "admin.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "oc2modmanager-notice-admin.ch3ng.top", "custom_domain": true }],
  "cache": { "enabled": false },
  "rules": [{ "type": "Text", "globs": ["**/web/*.html", "**/web/*.css", "**/web/*.js"], "fallthrough": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "oc2modmanager-notice",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
