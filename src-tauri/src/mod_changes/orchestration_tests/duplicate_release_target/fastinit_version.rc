// Metadata-only PE fixture: no entry point or runtime code. Tests append a
// synthetic BepInPlugin attribute (GUID, name and version) to these bytes.
// rc /fo fastinit_version.res fastinit_version.rc
// link /dll /noentry /nodefaultlib /noimplib /machine:x64 /brepro /out:fastinit_version.pe fastinit_version.res
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "OriginalFilename", "FastInit.dll\0"
            VALUE "ProductName", "FastInit\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
