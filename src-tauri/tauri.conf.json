{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OC2ModManager",
  "mainBinaryName": "OC2ModManager",
  "version": "1.3.2",
  "identifier": "com.ch3ngyz.oc2.modmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OC2 MOD Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' http://localhost:5173; connect-src 'self' http://localhost:5173 ws://localhost:5173 ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost http://localhost:5173 https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "nsis/installer.nsi",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Korean",
          "Japanese"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "OC2 MOD Manager",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0QUFGNzdGMzNBREM2Q0EKUldUS3hxMHpmL2VxeE9YV1VWaG0vUnlQaVd1VlNnazFVRXc5SVZqcFZnb2NrQkxLTytheE80QUgK",
      "endpoints": [
        "https://gitee.com/ch3ngyz/Overcooked-2-MOD-Manager/releases/download/latest/latest.json",
        "https://github.com/CH3NGYZ/Overcooked-2-MOD-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
